{
    "name": "ngfblog/laravel-actions",
    "version": "1.0.5",
    "description": "Simple actions package for Laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Henry Whitaker",
            "role": "Original author"
        }
    ],
    "homepage": "https://github.com/ngfblog/speedtest-tracker-v2/tree/master/packages/laravel-actions",
    "keywords": ["Laravel", "LaravelActions"],
    "require": {
        "illuminate/support": "~7|~8"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.0",
        "orchestra/testbench": "~5|~6"
    },
    "autoload": {
        "psr-4": {
            "NgfBlog\\LaravelActions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NgfBlog\\LaravelActions\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NgfBlog\\LaravelActions\\LaravelActionsServiceProvider"
            ]
        }
    }
}
